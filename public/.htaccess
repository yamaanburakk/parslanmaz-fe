# Pars Endüstriyel Mutfak - Apache Configuration
# www.parslanmaz.com

# Enable RewriteEngine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect non-www to www
  RewriteCond %{HTTP_HOST} ^parslanmaz\.com [NC]
  RewriteRule ^(.*)$ https://www.parslanmaz.com/$1 [L,R=301]

  # Handle trailing slashes (Next.js static export uses trailing slashes)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ $1/ [L,R=301]

  # Serve index.html for directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ $1/index.html [L,QSA]
</IfModule>

# Error Pages
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Prevent directory browsing
Options -Indexes

# Protect sensitive files
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Protect package.json, README, etc.
<FilesMatch "(package\.json|package-lock\.json|README\.md|\.env|\.git)">
  Order allow,deny
  Deny from all
</FilesMatch>

# Önbellek ayarları - Statik dosyalar için
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Görseller - 1 yıl
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS ve JS - 1 yıl
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Fontlar - 1 yıl
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    
    # HTML - 1 saat
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Gzip sıkıştırma
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  # X-Frame-Options: Allow only same origin (SAMEORIGIN allows Google Maps embed)
  Header always set X-Frame-Options "SAMEORIGIN"
  
  # X-Content-Type-Options: Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"
  
  # X-XSS-Protection: Enable XSS filter
  Header always set X-XSS-Protection "1; mode=block"
  
  # Referrer-Policy
  Header always set Referrer-Policy "origin-when-cross-origin"
  
  # DNS Prefetch Control
  Header always set X-DNS-Prefetch-Control "on"
  
  # Strict Transport Security (HSTS) - Requires HTTPS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Content Security Policy (CSP) - Updated for production (www.parslanmaz.com)
  # Includes: Google Maps, Google Analytics, Cloudflare Insights
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://maps.googleapis.com https://maps.gstatic.com https://*.google.com https://static.cloudflareinsights.com https://cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://maps.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: http: https://maps.googleapis.com https://maps.gstatic.com https://*.google.com https://*.googleapis.com https://*.gstatic.com; connect-src 'self' https://www.google-analytics.com https://maps.googleapis.com https://cloudflareinsights.com; frame-src 'self' https://www.google.com https://maps.google.com; frame-ancestors 'self';"
  
  # Permissions Policy
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# Cache Control Headers
<IfModule mod_headers.c>
  # Static assets with versioning (Next.js _next folder)
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # HTML files
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  
  # XML files (sitemap, rss)
  <FilesMatch "\.(xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# MIME türleri
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/json .json

# Türkçe karakter sorunları için encoding
AddDefaultCharset UTF-8

